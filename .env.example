PORT=3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/pulse
JWT_SECRET=replace-with-a-long-random-string
# GitHub personal access token (no scopes needed for public repos)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# How often the server pings every monitor (cron syntax). Default: every 5 minutes.
PING_CRON=*/5 * * * *
